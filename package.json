{
  "name": "ts-clean-architecture",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean:sample": "node scripts/clean-sample.js"
  },
  "dependencies": {
    "awilix": "^10.0.2",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "@apollo/server": "^4.11.0",
    "graphql": "^16.9.0",
    "@grpc/grpc-js": "^1.11.1",
    "@grpc/proto-loader": "^0.7.13",
    "mongodb": "^6.8.0",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "typescript": "^5.6.2",
    "tsx": "^4.19.0",
    "tsc-alias": "^1.8.10",
    "vitest": "^2.0.5",
    "pino-pretty": "^11.2.2"
  }
}
